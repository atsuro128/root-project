{
  "name": "Expense SaaS Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "Asia/Tokyo",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0",
      "GO_VERSION": "1.24.1",
      "GOLANGCI_LINT_VERSION": "v1.64.8"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--security-opt=no-new-privileges:true"
  ],
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "golang.go"
      ],
      "settings": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        },
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  },
  "forwardPorts": [3000, 8080],
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=codex-config-${devcontainerId},target=/home/node/.codex,type=volume",
    "source=gh-config-${devcontainerId},target=/home/node/.config/gh,type=volume",
    "source=${localEnv:USERPROFILE}/.gitconfig,target=/home/node/.gitconfig.host,type=bind,consistency=cached,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "GOPATH": "/home/node/go",
    "HTTP_PROXY": "http://127.0.0.1:3127",
    "HTTPS_PROXY": "http://127.0.0.1:3127",
    "ALL_PROXY": "http://127.0.0.1:3127",
    "http_proxy": "http://127.0.0.1:3127",
    "https_proxy": "http://127.0.0.1:3127",
    "all_proxy": "http://127.0.0.1:3127",
    "NO_PROXY": "localhost,127.0.0.1",
    "no_proxy": "localhost,127.0.0.1",
    "HOST_GATEWAY_TCP_PORTS": "3000,8080",
    "UPSTREAM_PROXY_HOST": "${localEnv:UPSTREAM_PROXY_HOST}",
    "UPSTREAM_PROXY_PORT": "${localEnv:UPSTREAM_PROXY_PORT}",
    "UPSTREAM_PROXY_USERNAME": "${localEnv:UPSTREAM_PROXY_USERNAME}",
    "UPSTREAM_PROXY_PASSWORD": "${localEnv:UPSTREAM_PROXY_PASSWORD}",
    "UPSTREAM_PROXY_PASSWORD_FILE": "${localEnv:UPSTREAM_PROXY_PASSWORD_FILE}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/root-project,type=bind,consistency=delegated",
  "workspaceFolder": "/root-project",
  "postCreateCommand": "cp /home/node/.gitconfig.host /home/node/.gitconfig 2>/dev/null || true && git config --global core.autocrlf input && git config --global core.fileMode false && git config --global --add safe.directory /root-project && git config --global --add safe.directory /root-project/expense-saas && git config --global --add safe.directory /root-project/dev-journal && git config --global --add safe.directory /root-project/ai-dev-framework && npm install -g @anthropic-ai/claude-code@latest @openai/codex@latest && /bin/bash /root-project/.devcontainer/setup-shell-aliases.sh",
  "postAttachCommand": "/usr/local/bin/announce-egress-status.sh"
}
