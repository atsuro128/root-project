{
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(golangci-lint *)",
      "Bash(gofmt *)",
      "Bash(npm run dev *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git -C *)",
      "Bash(date *)"
    ],
    "deny": [
      "Read(//)",
      "Read(~/**)",
      "Edit(//)",
      "Edit(~/**)",
      "Bash(git push *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/edit-scope-check.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.py\""
          }
        ]
      }
    ]
  }
}
